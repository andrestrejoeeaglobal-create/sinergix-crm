# Sinergix Negocio CRM — configuración local
# Copia este archivo a .env y ajusta valores.

# Base de datos (producción: PostgreSQL de Jorge)
# DATABASE_URL=postgresql+psycopg://crm:secret@localhost:5432/sinergix_crm
DATABASE_URL=sqlite:///./crm.db

# Webhook de pagos — firma HMAC. CAMBIAR EN PRODUCCIÓN.
PAYMENT_WEBHOOK_SECRET=dev-secret-cambiar-en-produccion

# Puntos que acredita el CRM por plan vendido (el sistema externo define el valor oficial)
PUNTOS_POR_PLAN=100

# Token opcional para disparar el cron nocturno (header X-Cron-Token). Vacío = sin protección.
CRON_TOKEN=

# Chatwoot — vacío = modo mock (los mensajes se registran en memoria, no se envían)
CHATWOOT_URL=
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Sistema externo de cotización (SQL Server vía adaptador) — vacío = modo mock
COTIZACION_URL=
COTIZACION_TOKEN=

# BiometriaAPI (Cloud Functions de Firebase) — vacío = modo mock
BIOMETRIA_URL=
BIOMETRIA_TOKEN=

# Google OAuth (Sherpas) + Google Contacts (People API)
# Google Cloud Console → APIs y servicios → Credenciales → OAuth 2.0
# Habilitar People API. El scope contacts es RESTRICTED:
# para despliegue interno basta modo Testing con usuarios permitidos.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
